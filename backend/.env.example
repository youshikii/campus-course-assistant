DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/backend
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=24
JWT_ALGORITHM=HS256

# OpenAI compatible chat completion API (DeepSeek by default)
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# Optional JSON body for a compatible provider; DeepSeek thinking is disabled by default
LLM_EXTRA_BODY={}

# OpenAI compatible embedding API (SiliconFlow bge-m3 by default)
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# Shared Chroma HTTP server, not a shared embedded directory
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8002
MCP_URL=http://127.0.0.1:8001/mcp
MCP_HOST=127.0.0.1
MCP_PORT=8001
MCP_TIMEOUT_SECONDS=20
AGENT_TIMEOUT_SECONDS=180
AGENT_RECURSION_LIMIT=16
